# Blog-Genius Microservices Root Deployment Variables

# User Service (Port 5001)
USER_PORT=5001
MONGO_URI=mongodb://localhost:27017/blog-genius-user
JWT_SECRET=your_jwt_secret_key_here

# Author Service (Port 5002)
AUTHOR_PORT=5002
DATABASE_URL=postgresql://user:password@neon-db-host/dbname?sslmode=require
RABBITMQ_URL=amqp://guest:guest@localhost:5672
GEMINI_API_KEY=your_gemini_api_key_here

# Blog Reader Service (Port 5003)
BLOG_PORT=5003
REDIS_URL=redis://localhost:6379

# Cloudinary Storage
Cloud_Name=your_cloudinary_cloud_name
Cloud_Api_Key=your_cloudinary_api_key
Cloud_Api_Secret=your_cloudinary_api_secret

# Google OAuth
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
